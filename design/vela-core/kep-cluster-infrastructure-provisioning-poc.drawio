        <mxCell id="user" value="&lt;b&gt;Fleet admin&lt;/b&gt;&lt;br&gt;kubectl apply SpokeCluster&lt;br&gt;edits ClusterPlane values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="hub" value="Hub cluster: atmos-scratch-chub1 (EKS 1.35, Atmos scratch; deny jsPolicies on Warn; node groups scaled to zero nightly by Atmos)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="640" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="sc" value="&lt;b&gt;SpokeCluster cpspoke1&lt;/b&gt;&lt;br&gt;mode: connect | provision | adopt&lt;br&gt;infraProvisioning.blueprintRef: eks-capi&lt;br&gt;bootstrap.planeRef: foundation-runtime&lt;br&gt;credential.aws: spoke role + externalId&lt;br&gt;status: 6 conditions, provisioning, bootstrap, infraIncarnation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="hub">
          <mxGeometry x="20" y="50" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;vela-core-cluster-core (hub role)&lt;/b&gt;&lt;br&gt;SpokeCluster controller + admission webhook&lt;br&gt;provision.go, release.go, bootstrap.go, connect path&lt;br&gt;Pod Identity: tenant-gokarna-cc-hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="hub">
          <mxGeometry x="340" y="50" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="defs" value="&lt;b&gt;Definitions and planes (vela-system)&lt;/b&gt;&lt;br&gt;ComponentDefinition eks-capi (substrate contract)&lt;br&gt;ComponentDefinition helm-flux (Flux v2 HelmRelease)&lt;br&gt;ClusterPlane eks-capi-foundation, foundation-runtime&lt;br&gt;ClusterBlueprint eks-capi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="hub">
          <mxGeometry x="20" y="190" width="280" height="110" as="geometry"/>
