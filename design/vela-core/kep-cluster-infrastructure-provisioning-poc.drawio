        <mxCell id="capicrs" value="&lt;b&gt;CAPI objects (vela-system)&lt;/b&gt;&lt;br&gt;Cluster, AWSManagedControlPlane, AWSManagedCluster, MachinePool, AWSManagedMachinePool, NodeadmConfig&lt;br&gt;labelled by the owning Application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="hub">
