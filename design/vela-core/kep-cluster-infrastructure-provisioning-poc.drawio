        <mxCell id="apps" value="&lt;b&gt;Applications owned by the SpokeCluster&lt;/b&gt;&lt;br&gt;sc-cpspoke1-infra-&amp;lt;uid8&amp;gt;[-n]: substrate components; apply-once, gc never (retain), take-over in adopt&lt;br&gt;sc-cpspoke1-bootstrap: topology cpspoke1, gc never; re-applied every pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="hub">
          <mxGeometry x="340" y="190" width="280" height="110" as="geometry"/>
