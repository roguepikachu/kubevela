        <mxCell id="velacore" value="&lt;b&gt;vela-core (Application engine)&lt;/b&gt;&lt;br&gt;render CUE, pre-dispatch dry run, deploy step, dispatch, health, state-keep&lt;br&gt;branch fix: stale-revision re-apply (b13a12b9c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="hub">
