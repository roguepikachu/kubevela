        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid: data or control path; dashed: identity, read or optional path&lt;br&gt;blue: hub; orange: AWS; green: spoke; purple: POC controller code; yellow: vela-core engine" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#999999;rounded=1;spacingLeft=6;" vertex="1" parent="1">
